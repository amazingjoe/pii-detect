{
  "model_path": "./models/Qwen2.5-1.5B",
  "layer": 12,
  "weights_path": "probe_weights.npz",
  "train": {
    "prep_dir": "./training/prep",
    "done_dir": "./training/done",
    "batch_size": 32,
    "test_size": 0.3,
    "random_state": 42,
    "move_to_done": false
  },
  "predict": {
    "threshold": 0.5,
    "chunk_tokens": 48,
    "chunk_overlap": 16
  },
  "eval": {
    "regressions_path": "./training/eval/regressions.json"
  },
  "sweep": {
    "folds": 5,
    "output_dir": "./probes",
    "report_path": "./sweep_report.html",
    "save_top": 3
  }
}
